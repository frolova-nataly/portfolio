---
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import { site } from '../data/site';
const { cta, contacts } = site;
---

<section class="cta" aria-labelledby="cta-title" id="contacts">
  <div class="container">
    <div class="cta__box">
      <h2 id="cta-title" class="cta__title">{cta.title}</h2>
      {cta.text && <p class="cta__text">{cta.text}</p>}
      <div class="cta__actions">
        <a class="btn btn--primary" href={contacts.telegram} target="_blank" rel="noopener">
          <Icon name="send" />
          Telegram {contacts.telegramHandle}
        </a>
        <CopyEmail variant="button" label={contacts.email} />
        <a class="btn btn--secondary" href={contacts.cv} download>
          <Icon name="download" />
          CV, PDF
        </a>
        <a class="btn btn--secondary" href={contacts.linkedin} target="_blank" rel="noopener">
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 32px 64px;
  }
  .cta__box {
    background: var(--accent);
    border-radius: 24px;
    padding: clamp(32px, 6vw, 64px);
  }
  .cta__title {
    font-size: clamp(32px, 4.6vw, 52px);
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .cta__text {
    margin-top: 16px;
    max-width: 52ch;
    font-size: 18px;
  }
  .cta__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta__actions :global(.btn--secondary) {
    border-color: rgb(0 0 0 / 0.18);
  }
  .cta__actions :global(.btn--secondary:hover) {
    background: rgb(255 255 255 / 0.5);
  }
  @media (max-width: 640px) {
    .cta__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
