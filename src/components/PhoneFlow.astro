---
// Флоу из нескольких телефонов. На широком экране — в ряд, на телефоне — карусель с прокруткой по одному.
interface Step {
  src: string;
  caption: string;
}
interface Props {
  steps: Step[];
  label: string; // что показывает флоу, для скринридера
  tint?: string;
  mobileOnly?: boolean; // показывать только на телефоне (например, обложка-карусель)
  noCaptions?: boolean;
}
const { steps, label, tint = '#F1F1EE', mobileOnly = false, noCaptions = false } = Astro.props;
---

<figure class:list={['pflow', mobileOnly && 'pflow--mobile-only']} style={`--tint:${tint}; --n:${steps.length}`}>
  <ol class="pflow__track" aria-label={label} tabindex="0">
    {
      steps.map((s, i) => (
        <li class="pflow__step">
          <img src={s.src} alt={s.caption} width="1080" height="2208" loading="lazy" decoding="async" />
          {!noCaptions && (
            <p>
              <span>{i + 1}</span>
              {s.caption}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  /* На всю ширину окна: подложка от края до края, телефоны — в ряд по центру */
  .pflow {
    margin: 48px 0 0;
    width: 100vw;
    margin-inline: calc((100vw - 100%) / -2);
    background: var(--tint);
  }
  .pflow__track {
    list-style: none;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 88px) clamp(24px, 4vw, 64px);
    max-width: 1760px;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 48px);
  }
  .pflow__track:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -4px;
  }
  .pflow__step {
    min-width: 0;
  }
  .pflow__step img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 340px;
    margin-inline: auto;
  }
  .pflow__step p {
    margin: 16px auto 0;
    max-width: 340px;
    display: flex;
    gap: 8px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .pflow__step p span {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pflow--mobile-only {
    display: none;
  }

  /* Планшет и телефон: карусель по одному экрану, виден край следующего */
  @media (max-width: 900px) {
    .pflow__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 20px;
      padding: 28px 20px;
      gap: 14px;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .pflow__track::-webkit-scrollbar {
      display: none;
    }
    .pflow__step {
      flex: 0 0 min(74%, 300px);
      scroll-snap-align: start;
    }
    .pflow__step:last-child {
      margin-right: 20px;
    }
    .pflow__step img,
    .pflow__step p {
      max-width: none;
    }
  }
  @media (max-width: 640px) {
    .pflow--mobile-only {
      display: block;
      margin-top: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pflow__track {
      scroll-behavior: smooth;
    }
  }
</style>
