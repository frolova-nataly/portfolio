---
// «Следующий кейс» — в конце страницы кейса. Порядок берётся из cases в site.ts,
// после последнего кейса снова идёт первый.
import Icon from './Icon.astro';
import { cases } from '../data/site';

interface Props {
  current: string; // id текущего кейса из site.ts
}
const { current } = Astro.props;
const linked = cases.filter((c) => c.href);
const i = linked.findIndex((c) => c.id === current);
const next = i === -1 ? undefined : linked[(i + 1) % linked.length];
---

{
  next && next.id !== current && (
    <nav class="next" aria-label="Следующий кейс">
      <a class="next__card" href={next.href}>
        <div class="next__text">
          <p class="next__label">Следующий кейс</p>
          <p class="next__meta">
            {next.logo && <img src={next.logo} alt="" width="24" height="24" />}
            <span>{next.company}</span>
            <span class="next__domain">{next.domain}</span>
          </p>
          <p class="next__title">
            {next.title}
            <span class="next__arrow" aria-hidden="true"><Icon name="arrow" size={24} /></span>
          </p>
          <p class="next__fact">{next.highlight.value}</p>
        </div>
        {
          next.image && (
            <div class={next.desktop ? 'next__shot is-desktop' : 'next__shot'} style={`--tint:${next.tint}`}>
              <img src={next.image} alt="" loading="lazy" />
            </div>
          )
        }
      </a>
    </nav>
  )
}

<style>
  .next {
    margin-top: 96px;
  }
  .next__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .next__card:hover {
    border-color: var(--ink);
  }
  .next__card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .next__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .next__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 20px;
    font-size: 15px;
    font-weight: 600;
  }
  .next__meta img {
    border-radius: 6px;
  }
  .next__domain {
    font-weight: 400;
    color: var(--ink-2);
  }
  .next__title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .next__arrow {
    display: inline-flex;
    transition: transform 0.2s;
  }
  .next__card:hover .next__arrow {
    transform: translateX(6px);
  }
  .next__fact {
    display: inline-block;
    margin-top: 20px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: var(--accent);
    font-size: 15px;
    font-weight: 600;
  }
  .next__shot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 260px;
    padding: 20px;
    border-radius: var(--r-sm);
    background: var(--tint);
    overflow: hidden;
  }
  .next__shot img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .next__shot.is-desktop img {
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  @media (prefers-reduced-motion: reduce) {
    .next__arrow {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .next {
      margin-top: 72px;
    }
    .next__card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    .next__shot {
      height: 200px;
    }
  }
</style>
